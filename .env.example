# Copy to .env and fill in. Never commit .env.
# Every value below is also settable as a real process environment variable;
# this file is only a convenience for local development.

# --- Instance -----------------------------------------------------------
# Base URL of the instance, no trailing path. HTTPS is required unless the
# host is localhost/127.0.0.1 (for a local mock).
SERVICENOW_INSTANCE_URL=https://dev12345.service-now.com

# --- Authentication -----------------------------------------------------
# One of: basic | oauth2_client_credentials
SERVICENOW_AUTH_MODE=basic

# Used when SERVICENOW_AUTH_MODE=basic
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=

# Used when SERVICENOW_AUTH_MODE=oauth2_client_credentials
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=
# Defaults to <instance_url>/oauth_token.do if unset.
SERVICENOW_OAUTH_TOKEN_URL=
# Optional space-separated scopes; most instances need none.
SERVICENOW_OAUTH_SCOPE=

# --- Safety -------------------------------------------------------------
# When true (the default) every mutating tool is removed from the tool list
# and additionally refuses at the service layer. Set to false deliberately.
SERVICENOW_READ_ONLY=true

# Hard ceiling on records any single tool call may return. An agent that asks
# for 50000 incidents gets this many, plus a truncation flag.
SERVICENOW_MAX_RECORDS=500

# Records fetched per underlying Table API request.
SERVICENOW_PAGE_SIZE=50
SERVICENOW_MAX_PAGE_SIZE=100

# --- Resilience ---------------------------------------------------------
SERVICENOW_TIMEOUT_SECONDS=30
SERVICENOW_MAX_RETRIES=4
SERVICENOW_RETRY_BASE_DELAY=0.5
SERVICENOW_RETRY_MAX_DELAY=20
# Retry-After values larger than this are clamped; a misbehaving gateway
# should not be able to park the server for an hour.
SERVICENOW_MAX_RETRY_AFTER=60
# Client-side throttle. 0 disables it.
SERVICENOW_RATE_LIMIT_PER_MINUTE=180

# --- Audit --------------------------------------------------------------
# Path for JSON-lines audit records. Unset means stderr.
# stdout is never used: it carries the MCP stdio transport.
SERVICENOW_AUDIT_LOG_PATH=
# Free-form identifier for the caller, recorded on every audit line.
SERVICENOW_ACTOR=mcp-client
